APP_NAME="Company Webmail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Phnom_Penh"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
PRIMARY_LOCALE=en
SECONDARY_LOCALE=km

# --- Permanent owner account (seeded once; leave OWNER_PASSWORD empty to auto-generate) ---
OWNER_NAME="Company Owner"
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Company / branding (placeholders — replace with real values before deployment) ---
COMPANY_NAME="Example Company"
MAIL_DOMAIN=example.test
WEBMAIL_URL=https://mail.example.test
COMPANY_ADMIN_EMAIL=admin@example.test
COMPANY_SUPPORT_EMAIL=support@example.test
BRAND_PRIMARY_COLOR=#2563eb
BRAND_ACCENT_COLOR=#0ea5e9
BRAND_LOGO_PATH=images/logo.svg

# --- Mailbox defaults ---
DEFAULT_MAILBOX_QUOTA_MB=1024
MAIL_LINUX_GROUP=mailusers
MAIL_SHARED_GROUP_PREFIX=mailshare-

# --- Mail server connectivity (set once Phase 1 server exists) ---
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
SMTP_SUBMISSION_HOST=127.0.0.1
SMTP_SUBMISSION_PORT=587
SMTP_SUBMISSION_ENCRYPTION=tls
MAIL_RELAY_DRIVER=direct

# --- Spam / quarantine ---
SPAM_FILTER_LEVEL=normal
QUARANTINE_RETENTION_DAYS=30

# --- Attachments ---
ATTACHMENT_MAX_SIZE_MB=25
CLAMAV_ENABLED=false

# --- Web Push (generate VAPID keys before enabling) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
